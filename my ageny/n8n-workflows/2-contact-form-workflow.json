{
  "name": "Handle Contact Form Submissions",
  "nodes": [
    {
      "parameters": {
        "path": "webhook/contact"
      },
      "id": "a1b2c3d4-e5f6-g7h8-i9j0-k1l2m3n4o5p6",
      "name": "Webhook - Contact Form Submission",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "contact-webhook"
    },
    {
      "parameters": {
        "fromEmail": "noreply@example.com",
        "toEmail": "={{ $node['Webhook - Contact Form Submission'].json.email }}",
        "subject": "Thank you for contacting us",
        "htmlBody": "Thank you, {{ $node['Webhook - Contact Form Submission'].json.name }}!\\n\\nWe have received your message and will get back to you within 24 hours.\\n\\nBest regards,\\nYour Name"
      },
      "id": "b2c3d4e5-f6g7-h8i9-j0k1-l2m3n4o5p6q7",
      "name": "Send acknowledgment email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [500, 200]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "sheetName": "Contact Inquiries",
        "columns": {
          "parameters": [
            {
              "name": "name",
              "value": "={{ $node['Webhook - Contact Form Submission'].json.name }}"
            },
            {
              "name": "email",
              "value": "={{ $node['Webhook - Contact Form Submission'].json.email }}"
            },
            {
              "name": "subject",
              "value": "={{ $node['Webhook - Contact Form Submission'].json.subject }}"
            },
            {
              "name": "message",
              "value": "={{ $node['Webhook - Contact Form Submission'].json.message }}"
            },
            {
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        }
      },
      "id": "c3d4e5f6-g7h8-i9j0-k1l2-m3n4o5p6q7r8",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [500, 400]
    },
    {
      "parameters": {
        "channel": "#contact-inquiries",
        "text": "New contact inquiry from {{ $node['Webhook - Contact Form Submission'].json.name }}\\nEmail: {{ $node['Webhook - Contact Form Submission'].json.email }}\\nSubject: {{ $node['Webhook - Contact Form Submission'].json.subject }}"
      },
      "id": "d4e5f6g7-h8i9-j0k1-l2m3-n4o5p6q7r8s9",
      "name": "Send Slack notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Webhook - Contact Form Submission": {
      "main": [
        [
          {
            "node": "Send acknowledgment email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log to Google Sheets",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Slack notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveManualExecutions": true,
    "callerPolicy": "owner"
  }
}
